# ====================================================================
# Konfigurasi Koneksi Database Supabase PostgreSQL / Cloud
# ====================================================================

# Masukkan Connection String PostgreSQL dari Supabase Project Anda:
# Dapatkan di: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=

# Port Server (Default: 5000)
PORT=5000

# JWT Secret untuk Autentikasi
JWT_SECRET=cendekia_secret_jwt_key_2026_super_secure

# Konfigurasi Tripay / Midtrans Payment Gateway (Opsional)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_PRIVATE_KEY=
PAYMENT_GATEWAY_MERCHANT_CODE=
PAYMENT_GATEWAY_SANDBOX=true

# Konfigurasi Fonnte / Wablas WhatsApp Gateway (Opsional)
WHATSAPP_TOKEN=
WHATSAPP_SENDER_NUMBER=
